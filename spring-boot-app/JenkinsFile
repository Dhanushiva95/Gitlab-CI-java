pipeline {
  agent {
    docker {
      // Official Maven container running Java 21 on Ubuntu (Fixes GLIBC & compilation version mismatches)
      image 'maven:3.9.6-eclipse-temurin-21-jammy'
      // Mount the host's Docker socket and tool binary securely
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock -v /usr/bin/docker:/usr/bin/docker'
    }
  }
  
  stages {
    stage('Checkout') {
      steps {
        sh 'echo "Source code checked out successfully"'
      }
    }

    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // Build the project and create a JAR file using Maven
        sh 'cd spring-boot-app && mvn clean package'
      }
    }

    stage('Static Code Analysis') {
      environment {
        // Uses the internal Docker bridge gateway IP to securely reach SonarQube on the same host
        SONAR_URL = "http://172.17.0.1:9000" 
      }
      steps {
        withCredentials([string(credentialsId: 'sonarauthtoken', variable: 'SONAR_AUTH_TOKEN')]) {
          sh 'cd spring-boot-app && mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.login=${SONAR_AUTH_TOKEN} -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "dhanushiva/ultimate-cicd:${BUILD_NUMBER}"
        // 🚀 This splits your 'docker-cred' into individual secure variables
        DOCKER_USER  = credentials('docker-cred_usr')
        DOCKER_PASS  = credentials('docker-cred_psw')
      }
      steps {
        script {
          // 1. Build the local image artifact
          sh 'cd spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
          
          // 2. Direct native login and push using shell commands to bypass plugin bugs
          sh '''
            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
            docker push ${DOCKER_IMAGE}
            docker logout
          '''
        }
      }
    }

    stage('Update Deployment File') {
        environment {
            GIT_REPO_NAME = "Gitlab-CI-java"
            GIT_USER_NAME = "Dhanushiva95"
        }
        steps {
            withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                sh '''
                    git config user.email "dsalert364@gmail.com"
                    git config user.name "DSalert"
                    BUILD_NUMBER=${BUILD_NUMBER}
                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                    git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                    git push https://${GITHUB_TOKEN}@://github.com{GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                '''
            }
        }
    }
  }
}

